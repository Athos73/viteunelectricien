    {
      "parameters": {
        "fromEmail": "REMPLACER@votredomaine.fr",
        "toEmail": "contact.fencium@gmail.com",
        "subject": "=Nouveau devis — {{ $('Préparer la ligne').item.json.metier }} à {{ $('Préparer la ligne').item.json.ville }} ({{ $('Préparer la ligne').item.json.code_postal }})",
        "emailFormat": "text",
        "text": "=Une nouvelle demande de devis vient d'être transmise à HelloArtisan.\n\n  Référence   : {{ $('Préparer la ligne').item.json.reference }}\n  Reçue le    : {{ $('Préparer la ligne').item.json.recu_le }}\n  Page        : {{ $('Préparer la ligne').item.json.source }}\n\n  Travaux     : {{ $('Préparer la ligne').item.json.metier }}\n  Délai       : {{ $('Préparer la ligne').item.json.delai }}\n  Budget      : {{ $('Préparer la ligne').item.json.budget }}\n  Logement    : {{ $('Préparer la ligne').item.json.logement }} — {{ $('Préparer la ligne').item.json.occupation }}\n\n  {{ $('Préparer la ligne').item.json.civilite }} {{ $('Préparer la ligne').item.json.prenom }} {{ $('Préparer la ligne').item.json.nom }}\n  {{ $('Préparer la ligne').item.json.telephone }}\n  {{ $('Préparer la ligne').item.json.email }}\n  {{ $('Préparer la ligne').item.json.adresse }}, {{ $('Préparer la ligne').item.json.code_postal }} {{ $('Préparer la ligne').item.json.ville }}\n\n  Commentaire : {{ $('Préparer la ligne').item.json.commentaire }}\n\n  Token HelloArtisan : {{ $('Préparer la ligne').item.json.ha_token }}",
        "options": {}
      },
