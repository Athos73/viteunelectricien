# --- HelloArtisan : API d'import de leads (https://lead-ws.helloartisan.com) ---
# Identifiants du compte partenaire. Ils ne sont lus que côté serveur, par
# src/lib/helloartisan.ts, et ne doivent jamais être préfixés NEXT_PUBLIC_.
HELLOARTISAN_LOGIN=
HELLOARTISAN_PASSWORD=
# PROD (défaut) ou PREP.
HELLOARTISAN_ENV=PROD

# --- n8n : recopie des leads une fois l'import confirmé (facultatif) ---
# Sans URL, la recopie est simplement ignorée : le formulaire fonctionne à
# l'identique. Voir docs/helloartisan.md pour la charge utile envoyée.
N8N_LEAD_WEBHOOK_URL=
# Envoyé en en-tête « Authorization: Bearer … » si renseigné.
N8N_LEAD_WEBHOOK_TOKEN=
